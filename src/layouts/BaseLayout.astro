---
import { SITE_CONFIG } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = SITE_CONFIG.description,
  currentPath = Astro.url.pathname,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_CONFIG.name}` : `${SITE_CONFIG.name} — ${SITE_CONFIG.subtitle}`;
const isHome = currentPath === '/' || currentPath === '';
const isPolicy = currentPath.startsWith('/policy');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へスキップ</a>

    <header class="site-header">
      <div class="container site-header-inner">
        <a href="/" class="site-brand" aria-label={`${SITE_CONFIG.name} トップページ`}>
          <span class="site-brand-mark" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <polyline points="14 2 14 8 20 8" />
              <line x1="8" y1="13" x2="16" y2="13" />
              <line x1="8" y1="17" x2="13" y2="17" />
            </svg>
          </span>
          <span class="site-brand-text">
            <span class="site-brand-name">{SITE_CONFIG.name}</span>
            <span class="site-brand-sub">{SITE_CONFIG.subtitle}</span>
          </span>
        </a>

        <nav class="site-nav" aria-label="メインナビゲーション">
          <a
            href="/"
            class="site-nav-link"
            aria-current={isHome ? 'page' : undefined}
          >
            記事一覧
          </a>
          <a
            href="/policy"
            class="site-nav-link"
            aria-current={isPolicy ? 'page' : undefined}
          >
            編集方針・免責事項
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer-inner">
        <div class="site-footer-top">
          <div class="site-footer-brand">
            <p class="site-footer-title">{SITE_CONFIG.name}</p>
            <p class="site-footer-disclaimer">
              本サイトは一次文献・診療ガイドラインに基づく学術・教育向けのリファレンス要約であり、個別の診療判断に代わるものではありません。臨床判断は必ず原典・最新ガイドラインおよび主治医の判断を優先してください。
            </p>
          </div>
          <ul class="site-footer-links">
            <li><a href="/">記事一覧</a></li>
            <li><a href="/policy#editorial-policy">編集方針</a></li>
            <li><a href="/policy#copyright-policy">著作権配慮</a></li>
            <li><a href="/policy#medical-disclaimer">医療免責事項</a></li>
          </ul>
        </div>
        <div class="site-footer-bottom">
          <span>&copy; {new Date().getFullYear()} {SITE_CONFIG.copyrightHolder}</span>
          <span>Vancouver citation format &middot; Evidence-based clinical reference</span>
        </div>
      </div>
    </footer>
  </body>
</html>
